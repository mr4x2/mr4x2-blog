[
  {"goto": "/"},
  {"click": {"role": "link", "name": "Reading"}, "label": "menu link"},
  {"wait": "location.pathname === '/reading/'"},
  {"expect": "$$('header a').map(a => a.textContent.trim()).filter(Boolean)", "equals": ["mr4x2 blog", "Contact", "Tags", "Reading", "About"], "label": "menu order"},
  {"expect": "$$('li[data-tags] time').map(t => t.textContent.trim())", "equals": ["2026-11-21", "2026-11-03", "2026-10-28", "2026-10-15", "2026-10-02"], "label": "flat list newest first"},
  {"expect": "!$('section[data-month]') && !$('main h2')", "label": "no month headings"},
  {"expect": "$$('li[data-tags] a[target=_blank]').length", "equals": 5, "label": "title links"},
  {"expect": "$$('li[data-tags] a[target=_blank]').every(a => /noopener/.test(a.rel))", "label": "noopener"},
  {"expect": "!$('li[data-tags] b') && document.body.textContent.includes('<b>bold</b> & \"quotes\"')", "label": "note shown as text"},
  {"expect": "getComputedStyle($$('li[data-tags] p')[1]).whiteSpace", "equals": "pre-line", "label": "multi-line note keeps its breaks"},
  {"expect": "!document.body.innerText.includes('about bluestore')", "label": "excerpt hidden"},
  {"expect": "$$('[role=group] button').map(b => b.textContent.trim())", "equals": ["All", "linux", "storage", "ceph", "machine learning"], "label": "tag buttons by count then name, original labels"},
  {"expect": "$({role:'status'}).textContent.trim()", "equals": "5 of 5", "label": "count"},
  {"shot": "before-tag"},
  {"click": {"role": "button", "name": "ceph"}, "label": "click ceph"},
  {"wait": "location.hash === '#tag=ceph'"},
  {"expect": "$$('li[data-tags]').filter(visible).map(li => li.querySelector('a').textContent.trim())", "equals": ["How the OSD allocator works"], "label": "only ceph rows"},
  {"expect": "[$({role:'status'}).textContent.trim(), $({role:'button', name:'ceph'}).getAttribute('aria-pressed')]", "equals": ["1 of 5", "true"], "label": "count and pressed"},
  {"shot": "after-tag"},
  {"click": {"role": "button", "name": "machine learning"}, "label": "click tag with a space"},
  {"wait": "location.hash === '#tag=machine-learning'"},
  {"expect": "$({role:'status'}).textContent.trim()", "equals": "1 of 5", "label": "space tag filters"},
  {"click": {"role": "button", "name": "All"}, "label": "click All"},
  {"wait": "location.hash === ''"},
  {"expect": "[$({role:'status'}).textContent.trim(), $({role:'button', name:'All'}).getAttribute('aria-pressed')]", "equals": ["5 of 5", "true"], "label": "all rows back"},
  {"fill": {"role": "searchbox", "name": "Search bookmarks"}, "value": "BlueStore", "label": "search a word only in the excerpt"},
  {"expect": "$$('li[data-tags]').filter(visible).map(li => li.querySelector('a').textContent.trim())", "equals": ["How the OSD allocator works"], "label": "excerpt match"},
  {"fill": {"role": "searchbox", "name": "Search bookmarks"}, "value": "  tiếng "},
  {"expect": "$$('li[data-tags]').filter(visible).map(li => li.querySelector('a').textContent.trim())", "equals": ["Tiếng Việt"], "label": "vietnamese match, trimmed"},
  {"click": {"role": "button", "name": "ceph"}, "label": "tag plus search"},
  {"wait": "location.hash === '#tag=ceph'"},
  {"expect": "$({role:'status'}).textContent.trim()", "equals": "0 of 5", "label": "search and tag combine"},
  {"fill": {"role": "searchbox", "name": "Search bookmarks"}, "value": "zzz-nothing"},
  {"expect": "[$({role:'status'}).textContent.trim(), $$('li[data-tags]').filter(visible).length]", "equals": ["0 of 5", 0], "label": "no match"},
  {"shot": "no-match"},
  {"goto": "/", "label": "leave the page so the next hash goto reloads"},
  {"expect": "!$$('main li a').some(a => a.href.endsWith('/reading/'))", "label": "reading not in All Posts"},
  {"goto": "/reading/#tag=storage", "label": "shared link"},
  {"expect": "[$({role:'status'}).textContent.trim(), $({role:'button', name:'storage'}).getAttribute('aria-pressed')]", "equals": ["2 of 5", "true"], "label": "shared link filters"},
  {"goto": "/tags/"},
  {"expect": "!$$('main a').some(a => /^(ceph|storage|linux|machine)/i.test(a.textContent.trim()))", "label": "no bookmark tags on Tags"},
  {"goto": "/reading/#tag=nope", "label": "link to a tag that no longer exists"},
  {"expect": "[$({role:'status'}).textContent.trim(), $({role:'button', name:'All'}).getAttribute('aria-pressed')]", "equals": ["5 of 5", "true"], "label": "unknown tag falls back to All"}
]
