[
  {"goto": "/"},
  {"wait": "!document.documentElement.className.includes('intro')", "label": "intro finished"},
  {"expect": "$('.who .cmd').textContent.replace(/\\s+/g, ' ').trim()", "equals": "$ whoami", "label": "prompt reads whoami"},
  {"expect": "$('.who-out').textContent.trim().startsWith('mr8: Ceph object storage engineer')", "label": "whoami line from params"},
  {"expect": "$('.sec .cmd').textContent.trim()", "equals": "$ ls -t ~/posts", "label": "ls line"},
  {"expect": "$$('.tag-line a').map(a => a.textContent.trim())", "equals": ["#travel", "#fossasia", "#france", "#openinfra-submit", "#thailand"], "label": "tag line"},
  {"expect": "$$('.post-title a').map(a => a.textContent.trim())", "equals": ["Memorable days in France", "A great trip in Thailand"], "label": "posts newest first"},
  {"expect": "$$('.post-date').map(d => d.textContent.trim())", "equals": ["2026-02-17", "2025-03-29"], "label": "dates"},
  {"expect": "$$('.post-tags').map(ul => [...ul.querySelectorAll('a')].map(a => a.textContent.trim()).join(' '))", "equals": ["#travel #france #openinfra-submit", "#travel #thailand #fossasia"], "label": "row tags"},
  {"expect": "!$$('.post a').some(a => /\\/(about|reading)\\//.test(a.href))", "label": "About and Reading are not listed"},
  {"expect": "!$('.pager')", "label": "no pager under one page"},
  {"expect": "$$('.post-thumb img').length", "equals": 2, "label": "a thumbnail per row"},
  {"scroll": ".post-thumb img"},
  {"wait": "$$('.post-thumb img').every(i => i.complete && i.naturalWidth > 0)", "label": "thumbnails load"},
  {"expect": "performance.getEntriesByType('resource').filter(e => e.name.includes('/photos/')).every(e => e.encodedBodySize < 30000)", "label": "thumbnails are resized, not the originals"},
  {"expect": "getComputedStyle($('.who')).borderLeftWidth", "equals": "0px", "label": "whoami has no accent border"},
  {"shot": "home"},
  {"text": "home"},
  {"click": {"role": "link", "name": "tags/"}, "label": "menu: tags"},
  {"wait": "location.pathname === '/tags/'"},
  {"goto": "/"},
  {"click": {"role": "link", "name": "#travel"}, "label": "tag line: travel"},
  {"wait": "location.pathname === '/tags/travel/'"},
  {"goto": "/"},
  {"click": {"role": "link", "name": "A great trip in Thailand"}, "label": "open a post"},
  {"wait": "location.pathname === '/a-great-trip-in-thailand/'"},
  {"click": {"role": "link", "name": "mr4x2 blog"}, "label": "logo returns home"},
  {"wait": "location.pathname === '/'"}
]
