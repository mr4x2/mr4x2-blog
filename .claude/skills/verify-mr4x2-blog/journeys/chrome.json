[
  {"goto": "/"},
  {"expect": "$$('header nav a').map(a => a.textContent.trim())", "equals": ["reading/", "tags/", "about/", "contact"], "label": "menu links"},
  {"expect": "nameOf($('header a'))", "equals": "mr4x2 blog", "label": "logo name"},
  {"expect": "$('header a').textContent.trim()", "equals": "mr4x2@blog:~$", "label": "logo text"},
  {"expect": "[...document.fonts].filter(f => f.status === 'loaded').map(f => f.family.replace(/\"/g, '') + ' ' + f.weight).sort()", "equals": ["Inter 400", "Inter 600", "JetBrains Mono 400", "JetBrains Mono 700"], "label": "self-hosted fonts load", "timeout": 5000},
  {"expect": "document.documentElement.dataset.theme", "equals": "light", "label": "light by default"},
  {"expect": "document.querySelector('meta[name=color-scheme]').content", "equals": "light"},
  {"expect": "$('footer').textContent.replace(/\\s+/g, ' ').trim().replace(/\\d{4}/, 'YEAR')", "equals": "© YEAR mr4x2 · github · rss · built with hugo", "label": "footer line"},
  {"expect": "[$('footer a[href$=\"/index.xml\"]'), $('footer a[href=\"https://github.com/mr4x2\"]')].every(Boolean)", "label": "footer links"},
  {"shot": "light"},
  {"text": "light"},
  {"click": {"role": "button", "name": "Toggle dark mode"}, "label": "toggle to dark"},
  {"wait": "document.documentElement.dataset.theme === 'dark' && !document.documentElement.classList.contains('theme-reveal')", "label": "the theme reveal finishes"},
  {"expect": "[document.documentElement.dataset.theme, localStorage.getItem('mk-theme'), $({role:'button', name:'Toggle dark mode'}).getAttribute('aria-pressed')]", "equals": ["dark", "dark", "true"], "label": "dark is saved"},
  {"expect": "getComputedStyle(document.body).backgroundColor", "equals": "rgb(14, 16, 15)", "label": "dark page color"},
  {"expect": "document.querySelector('meta[name=theme-color]').content", "equals": "#0e100f", "label": "theme-color follows"},
  {"shot": "dark"},
  {"text": "dark"},
  {"early": "({theme: document.documentElement.dataset.theme, bg: getComputedStyle(document.documentElement).backgroundColor})"},
  {"goto": "/", "label": "reload in dark"},
  {"wait": "document.documentElement.hasAttribute('data-first-frame')"},
  {"expect": "JSON.parse(document.documentElement.getAttribute('data-first-frame'))", "equals": {"theme": "dark", "bg": "rgb(14, 16, 15)"}, "label": "first frame is dark"},
  {"expect": "!!document.head.querySelector('script:not([src])') && !!(document.head.querySelector('script:not([src])').compareDocumentPosition(document.head.querySelector('link[rel=stylesheet]')) & Node.DOCUMENT_POSITION_FOLLOWING)", "label": "theme script runs before the stylesheet"},
  {"click": {"role": "button", "name": "Toggle dark mode"}, "label": "toggle back to light"},
  {"wait": "document.documentElement.dataset.theme === 'light' && !document.documentElement.classList.contains('theme-reveal')", "label": "the theme reveal finishes"},
  {"expect": "[document.documentElement.dataset.theme, localStorage.getItem('mk-theme')]", "equals": ["light", "light"], "label": "light is saved"},
  {"shot": "light-again"}
]
