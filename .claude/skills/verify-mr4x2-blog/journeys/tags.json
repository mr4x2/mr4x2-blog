[
  {"goto": "/"},
  {"wait": "!document.documentElement.className.includes('intro')"},
  {"click": {"role": "link", "name": "tags/"}, "label": "menu: tags"},
  {"wait": "location.pathname === '/tags/'"},
  {"expect": "$('.sec .cmd').textContent.trim()", "equals": "$ ls ~/tags", "label": "command line"},
  {"expect": "$$('.tag-index a').map(a => nameOf(a))", "equals": ["#travel (2)", "#fossasia (1)", "#france (1)", "#openinfra-submit (1)", "#thailand (1)"], "label": "every tag with its count"},
  {"expect": "!$$('main a').some(a => /^#?(readme|info|ceph|storage|linux|machine)/i.test(a.textContent.trim()))", "label": "no About or Bookmark tags"},
  {"expect": "$('h1').textContent.trim()", "equals": "Tags", "label": "the page has a heading"},
  {"shot": "tags"},
  {"text": "tags"},
  {"click": {"role": "link", "name": "#travel (2)"}, "label": "open a tag"},
  {"wait": "location.pathname === '/tags/travel/'"},
  {"expect": "$('.sec .cmd').textContent.trim()", "equals": "$ ls -t ~/posts --tag=travel", "label": "tag command line"},
  {"expect": "$$('.post-title a').map(a => a.textContent.trim())", "equals": ["Memorable days in France", "A great trip in Thailand"], "label": "the right posts, newest first"},
  {"shot": "tag-travel"},
  {"text": "tag-travel"},
  {"goto": "/tags/thailand/"},
  {"expect": "$$('.post-title a').map(a => a.textContent.trim())", "equals": ["A great trip in Thailand"], "label": "a tag with one post"},
  {"goto": "/"},
  {"wait": "!document.documentElement.className.includes('intro')"},
  {"click": {"role": "link", "name": "#france"}, "label": "tag line on the home page"},
  {"wait": "location.pathname === '/tags/france/'"},
  {"expect": "$$('.post-title a').map(a => a.textContent.trim())", "equals": ["Memorable days in France"]},
  {"expect": "Promise.all(['/tags/readme/', '/tags/info/', '/tags/ceph/'].map(u => fetch(u).then(r => r.status)))", "equals": [404, 404, 404], "label": "removed and bookmark tags have no page"}
