[
  {"goto": "/"},
  {"wait": "!document.documentElement.className.includes('intro')", "label": "intro finished"},
  {"click": {"role": "link", "name": "A great trip in Thailand"}, "label": "open the post from the list"},
  {"wait": "location.pathname === '/a-great-trip-in-thailand/'"},
  {"expect": "$('.article-meta').textContent.replace(/\\s+/g, ' ').trim().replace(/\\d+ min/, 'N min')", "equals": "2025-03-29 · N min read", "label": "date and reading time"},
  {"expect": "$('h1').textContent.trim()", "equals": "A great trip in Thailand", "label": "title"},
  {"expect": "$$('article .post-tags a').map(a => a.textContent.trim())", "equals": ["#travel", "#thailand", "#fossasia"], "label": "tags"},
  {"expect": "[$('details.toc').open, $('details.toc summary').textContent.replace(/\\s+/g, ' ').trim(), $$('details.toc a').length > 0]", "equals": [true, "$ cat toc", true], "label": "table of contents is open and labelled"},
  {"shot": "post-top", "viewport": true},
  {"text": "post-top"},
  {"click": ".toc a", "label": "first TOC link"},
  {"expect": "location.hash.length > 1 && document.getElementById(decodeURIComponent(location.hash.slice(1))).getBoundingClientRect().top >= $('header').offsetHeight - 2", "label": "the heading stops below the sticky header"},
  {"expect": "$$('figure figcaption').map(f => f.textContent.trim()).slice(0, 2)", "equals": ["Canals in Bangkok", "Pad Thai"], "label": "captions come from the image titles"},
  {"expect": "(f => { const r = f.querySelector('img').getBoundingClientRect(), p = $('.prose').getBoundingClientRect(); return Math.abs((r.left + r.width / 2) - (p.left + p.width / 2)) < 2 && getComputedStyle(f).textAlign === 'center'; })($('figure'))", "label": "a #center image is centered"},
  {"scroll": "img[title='Pad Thai']"},
  {"wait": "(i => i.complete && i.naturalWidth > 0)($(\"img[title='Pad Thai']\"))", "timeout": 15000, "label": "photo loads"},
  {"shot": "post-figure", "viewport": true},
  {"expect": "document.documentElement.scrollWidth <= VW", "label": "no sideways scroll, iframe included"},
  {"expect": "$('script[type=\"application/ld+json\"]').textContent.includes('/trip-in-Thailand/speakers.JPEG') && $('meta[property=\"og:image\"]').content.endsWith('/trip-in-Thailand/speakers.JPEG')", "label": "JSON-LD and social preview use the post image"},
  {"expect": "(g => [g.dataset.theme === document.documentElement.dataset.theme, g.dataset.mapping, g.dataset.repo])($('script[src=\"https://giscus.app/client.js\"]'))", "equals": [true, "pathname", "mr4x2/mr4x2-blog"], "label": "giscus script loads with the site theme"},
  {"expect": "(() => { const pre = document.createElement('div'); pre.className = 'highlight'; pre.innerHTML = '<pre class=\"chroma\"><code><span class=\"line\"><span class=\"cl\"><span class=\"k\">if</span> <span class=\"nf\">run</span>()</span></span></code></pre>'; $('.prose').append(pre); const dark = document.documentElement.dataset.theme === 'dark'; return [getComputedStyle(pre.querySelector('.k')).color, getComputedStyle(pre.querySelector('.nf')).color].join(' ') === (dark ? 'rgb(255, 123, 114) rgb(210, 168, 255)' : 'rgb(207, 34, 46) rgb(102, 57, 186)'); })()", "label": "Chroma palette follows the theme"},
  {"scroll": ".highlight"},
  {"shot": "post-code", "viewport": true},
  {"scroll": ".article-nav"},
  {"expect": "$$('.article-nav a').map(a => a.textContent.replace(/\\s+/g, ' ').trim())", "equals": ["newer Memorable days in France"], "label": "the oldest post links only to a newer one"},
  {"click": {"role": "link", "name": "newer Memorable days in France"}, "label": "newer post"},
  {"wait": "location.pathname === '/memorable-days-in-france/'"},
  {"expect": "$$('.article-nav a').map(a => a.textContent.replace(/\\s+/g, ' ').trim())", "equals": ["older A great trip in Thailand"], "label": "the newest post links only to an older one"},
  {"click": {"role": "link", "name": "cd ~"}, "label": "cd ~ goes home"},
  {"wait": "location.pathname === '/'"}
]
