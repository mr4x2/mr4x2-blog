[
  {"goto": "/"},
  {"wait": "!document.documentElement.className.includes('intro')"},
  {"expect": "[$('[data-search-popup]').hidden, $('[role=dialog]').getAttribute('aria-modal'), $('[role=combobox]').getAttribute('aria-controls') === $('[role=listbox]').id]", "equals": [true, "true", true], "label": "closed dialog, combobox controls the listbox"},
  {"expect": "$('[data-search-hint]').textContent", "equals": "Ctrl K", "label": "the hint matches this platform"},
  {"eval": "$('header nav a').focus()", "label": "focus a menu link"},
  {"key": "k", "ctrl": true},
  {"expect": "[!$('[data-search-popup]').hidden, document.activeElement === $('[role=combobox]')]", "equals": [true, true], "label": "ctrl+K opens the popup and focuses the input"},
  {"wait": "$('[data-search-popup] [role=status]').textContent === 'Type a word to search the posts.'", "label": "index loaded, hint shown"},
  {"type": "Bangkok"},
  {"wait": "$$('[role=option]').length > 0", "timeout": 10000, "label": "results appear"},
  {"expect": "$$('[role=option] .search-title').map(t => t.textContent)", "equals": ["A great trip in Thailand"], "label": "Bangkok finds only the Thailand post"},
  {"expect": "$('[role=option] .search-meta').textContent", "equals": "2025-03-29 · #travel #thailand #fossasia", "label": "date and tags"},
  {"expect": "$$('[role=option] mark').some(m => /bangkok/i.test(m.textContent))", "label": "the excerpt highlights the match"},
  {"expect": "[$('[role=option]').getAttribute('aria-selected'), $('[role=combobox]').getAttribute('aria-activedescendant') === $('[role=option]').id, $('[role=combobox]').getAttribute('aria-expanded')]", "equals": ["true", true, "true"], "label": "first result is selected and announced"},
  {"shot": "search-bangkok"},
  {"text": "search-bangkok"},
  {"key": "Escape"},
  {"expect": "[$('[data-search-popup]').hidden, document.activeElement === $('header nav a')]", "equals": [true, true], "label": "Esc closes and returns focus to the menu link"},
  {"key": "/"},
  {"expect": "[!$('[data-search-popup]').hidden, document.activeElement === $('[role=combobox]')]", "equals": [true, true], "label": "/ opens it when focus is not in a field"},
  {"type": "trip"},
  {"wait": "$$('[role=option]').length === 2", "timeout": 10000, "label": "two posts mention trip"},
  {"key": "ArrowDown"},
  {"expect": "$$('[role=option]').map(o => o.getAttribute('aria-selected'))", "equals": ["false", "true"], "label": "arrow down moves the selection"},
  {"key": "ArrowUp"},
  {"expect": "$$('[role=option]').map(o => o.getAttribute('aria-selected'))", "equals": ["true", "false"], "label": "arrow up moves it back"},
  {"key": "ArrowDown"},
  {"hover": "[role=option]:first-child"},
  {"expect": "$$('[role=option]').map(o => o.getAttribute('aria-selected'))", "equals": ["true", "false"], "label": "moving the mouse over a row selects it"},
  {"key": "ArrowDown"},
  {"eval": "sessionStorage.setItem('picked', $$('[role=option]')[1].querySelector('.search-title').textContent)"},
  {"shot": "search-trip"},
  {"key": "Enter"},
  {"wait": "location.pathname !== '/'", "timeout": 10000, "label": "Enter opens the selected post"},
  {"expect": "$('h1').textContent.trim() === sessionStorage.getItem('picked')", "label": "it is the post that was selected"},
  {"key": "k", "ctrl": true},
  {"type": "zzzqq"},
  {"wait": "$('[data-search-popup] [role=status]').textContent === 'grep: no posts match \"zzzqq\"'", "timeout": 10000, "label": "no match message"},
  {"shot": "search-empty"},
  {"text": "search-empty"},
  {"key": "k", "ctrl": true},
  {"expect": "$('[data-search-popup]').hidden", "label": "ctrl+K closes it again"},
  {"click": {"role": "button", "name": "Search posts"}, "label": "the header button opens it"},
  {"type": "passionate"},
  {"wait": "$$('[role=option] .search-title').map(t => t.textContent).join() === 'About Me'", "timeout": 10000, "label": "About is searchable"},
  {"tap": [8, 8], "label": "a click on the backdrop closes it"},
  {"expect": "$('[data-search-popup]').hidden"},
  {"key": "k", "ctrl": true},
  {"type": "Paris"},
  {"wait": "$$('[role=option]').length > 0", "timeout": 10000},
  {"expect": "$$('[role=option] .search-title').map(t => t.textContent)", "equals": ["Memorable days in France"], "label": "a word from the France post finds only that post"}
]
